{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "declaration": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["lista-de-compras"],
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "paths": {
      "@lista/contracts": ["./libs/contracts/src/index.ts"],
      "@lista/shared/util": ["./libs/shared/util/src/index.ts"],
      "@lista/ui-web": ["./libs/ui-web/src/index.ts"]
    }
  }
}

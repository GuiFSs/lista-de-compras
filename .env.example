# Variáveis de ambiente base para desenvolvimento local.
# Copie para `.env` na raiz: cp .env.example .env  (o `.env` é ignorado pelo git)
# Credenciais locais de desenvolvimento - nunca usar em produção.

# Serviço de lista de compras (ADR 0001)
PORT=3000
DATABASE_URL=postgresql://shopping_list:shopping_list_local@localhost:5432/shopping_list

# Mensageria (ADR 0001)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Senhas dos bancos lógicos por serviço, usadas pelo Docker Compose
# ao criar os bancos no primeiro boot do Postgres (docker/compose.dev.yml)
AUTH_DB_PASSWORD=auth_local
SHOPPING_LIST_DB_PASSWORD=shopping_list_local
PRICE_HISTORY_DB_PASSWORD=price_history_local

# Bancos dos próximos serviços (sem código ainda):
# AUTH_DATABASE_URL=postgresql://auth:auth_local@localhost:5432/auth
# PRICE_HISTORY_DATABASE_URL=postgresql://price_history:price_history_local@localhost:5432/price_history

# Variáveis de ambiente base para desenvolvimento local.
# Copie para `.env` na raiz: cp .env.example .env  (o `.env` é ignorado pelo git)
# Credenciais locais de desenvolvimento - nunca usar em produção.

# Serviço de lista de compras (ADR 0001)
# API_PORT e não PORT: o Nx injeta o .env em todos os targets e o Angular
# dev-server usa a variável PORT (terminaria na porta errada).
API_PORT=3000
DATABASE_URL=postgresql://shopping_list:shopping_list_local@localhost:5432/shopping_list
# CORS local do shopping-list-service (ADR 0009): origem(ns) autorizadas a
# chamar o serviço direto. A PWA (http://localhost:4200) e o serviço
# (http://localhost:3000) são origens diferentes — o CORS é a exceção
# temporária à ADR 0001 que viabiliza a chamada, removida na migração para o
# gateway (ADR 0009 §3). Comentada: vale o default local; CSV para mais de uma
# origem. Não é controle de segurança — a autorização é o JWT (ADR 0007).
# SHOPPING_LIST_CORS_ORIGINS=http://localhost:4200
# Reconhecimento de nota (feature receipt-purchase; ADR 0012).
# Chave só no backend — nunca na PWA. Tier Free da Gemini Developer API.
# SHOPPING_LIST_GEMINI_API_KEY=
# Opcional; default gemini-3.1-flash-lite (Flash do free tier; ADR 0012).
# SHOPPING_LIST_GEMINI_MODEL=gemini-3.1-flash-lite

# Mensageria (ADR 0001) — mesma URL para os dois lados do evento
# shopping-list.purchase-completed (feature "Histórico de preços"):
# - shopping-list-service: produtor (outbox → RabbitMQ)
# - price-history-service: consumidor (fila → ingestão no banco price_history)
# Broker local via Docker (npm run docker:up); guest/guest só em desenvolvimento.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Senhas dos bancos lógicos por serviço, usadas pelo Docker Compose
# ao criar os bancos no primeiro boot do Postgres (docker/compose.dev.yml)
AUTH_DB_PASSWORD=auth_local
SHOPPING_LIST_DB_PASSWORD=shopping_list_local
PRICE_HISTORY_DB_PASSWORD=price_history_local

# Autenticação — auth-service (feature "Autenticação"; ADR 0006 e 0007)
# Prefixo AUTH_* por serviço (ADR 0006): o Nx injeta o .env em todos os
# targets, então PORT/API_PORT nunca são reutilizados por serviços novos.
# O banco lógico `auth` já é criado pelo Docker local (ADR 0004) e pertence
# somente ao auth-service (RN6/ADR 0001) — ninguém mais lê esse banco.
AUTH_DATABASE_URL=postgresql://auth:auth_local@localhost:5432/auth
AUTH_API_PORT=3001
AUTH_CORS_ORIGINS=http://localhost:4200
AUTH_JWT_ISSUER=auth-service
# Par de chaves RS256 (base64 single-line para o .env). Gere no `.env`
# LOCAL com `npm run auth:keys` — estes valores são apenas placeholders;
# o `.env` é ignorado pelo git e chaves reais nunca entram no repo.
# AUTH_JWT_ISSUER e AUTH_JWT_PUBLIC_KEY_B64 também são lidas pelo
# shopping-list-service e pelo price-history-service: cada serviço valida
# localmente o JWT na própria borda HTTP com a chave pública (ADR 0007).
# A privada (`AUTH_JWT_PRIVATE_KEY_B64`) existe somente no auth-service.
AUTH_JWT_PRIVATE_KEY_B64=<>
AUTH_JWT_PUBLIC_KEY_B64=<>
# Conta única local (ADR 0002, RN8): o `.env` local é a fonte de verdade
# do seed; o username abaixo é o default, a senha fica só no seu `.env`.
AUTH_SEED_USERNAME=lista
# defina uma senha local; nunca commite
AUTH_SEED_PASSWORD=
# Custo do bcrypt para o hash da senha (RN4 — OWASP recomenda >= 10)
AUTH_PASSWORD_HASH_COST=12
# Rate limit do login (RN13): máx. de 5 falhas por janela de 60s, por IP
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Histórico de preços — price-history-service (feature "Histórico de preços";
# ADR 0010). Prefixo PRICE_HISTORY_* (ADR 0006 §4 / ADR 0010 §4). Exceção
# temporária ao gateway: PWA → http://localhost:3002 (porta 3002) enquanto o
# gateway não existir. O banco lógico `price_history` já é criado pelo Docker
# local (ADR 0004) e pertence somente a este serviço (RN-01/ADR 0001).
# Também lê RABBITMQ_URL (consumidor) e AUTH_JWT_PUBLIC_KEY_B64 /
# AUTH_JWT_ISSUER (validação local do JWT — ADR 0007).
PRICE_HISTORY_DATABASE_URL=postgresql://price_history:price_history_local@localhost:5432/price_history
PRICE_HISTORY_API_PORT=3002
# CORS local (ADR 0010 §2): origem(ns) autorizadas a chamar o serviço direto.
# Methods GET/OPTIONS e headers Content-Type, Authorization. Comentada: vale o
# default local; CSV para mais de uma origem. Não é controle de segurança —
# a autorização é o JWT (ADR 0007). Removido na migração para o gateway
# (ADR 0010 §3).
# PRICE_HISTORY_CORS_ORIGINS=http://localhost:4200
